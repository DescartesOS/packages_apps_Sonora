package {
    default_applicable_licenses: ["Sonora_license"],
}

license {
    name: "Sonora_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-GPL-3.0"],
    license_text: ["LICENSE"],
}

// Gradle builds the Compose app; Soong installs and signs its release APK.
android_app_import {
    name: "Sonora",
    apk: "prebuilt/Sonora.apk",
    product_specific: true,
    default_dev_cert: true,
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },
}
